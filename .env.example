# Copy to .env. Never commit tokens, credentials, or database backups.
# Runtime needs TOKEN. Deployment --apply also needs explicit BOT_CLIENT_ID.
TOKEN=your-bot-token-here
BOT_CLIENT_ID=953610843692617788
OWNER_ID=543313602942337035
BOT_PREFIX="sm "
EMBED_COLOR="#ffb8bf"
EMBED_FOOTER_TEXT="Made with ❤️ using Discord.js"
EMBED_FOOTER_TEXT_1="Find more commands with 'sm help'"
EMBED_FOOTER_TEXT_2="Find more commands with '/help'"

# Optional: ownership AND giveaways are unavailable without MongoDB.
MONGODB=

# JSON arrays; these values preserve the original default blocked IDs.
BLOCKED_CHANNEL_IDS=["674556658248187926","954368773090082846","954368755872464926","956890086845317122"]
BLOCKED_USER_IDS=["12345678909876543456"]
PET_USER_ID=445158576281878539

# Empty means disabled. Only opt in on a host with PM2 installed and this process.
# Docker has no PM2; use docker compose restart/stop instead.
PM2_PROCESS_NAME=

# Operator-owned guild mappings default to empty. Before existing-guild cutover,
# set this to the complete original-guild example in README (verify its IDs).
GUILD_CONFIG_JSON={}
