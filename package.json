{
  "name": "smol-maiden",
  "version": "1.0.0",
  "description": "A Discord.js bot with personal channel controls, utilities, and games.",
  "main": "dist/index.js",
  "author": "frxskie#1009",
  "scripts": {
    "start": "node dist/index.js",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "deploy:commands": "node dist/scripts/deploy-commands.js"
  },
  "keywords": [],
  "license": "ISC",
  "dependencies": {
    "canvas": "^3.2.3",
    "discord.js": "^14.28.1",
    "dotenv": "^10.0.0",
    "mathjs": "^10.6.4",
    "mongoose": "^6.4.2",
    "pet-pet-gif": "^1.0.9"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "eslint": "9.39.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Frsxk/smol-maiden-bot.git"
  },
  "bugs": "https://github.com/Frsxk/smol-maiden-bot/issues",
  "homepage": "https://github.com/Frsxk/smol-maiden-bot#readme",
  "overrides": {
    "canvas": "$canvas"
  },
  "allowScripts": {
    "canvas@3.2.3": true
  }
}
